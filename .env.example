# Copy to .env and adjust if needed. Defaults below match docker-compose.yml.
APP_ENV=dev
HTTP_ADDR=:8081
DATABASE_URL=postgres://coin:coin@localhost:55432/coin?sslmode=disable
REDIS_URL=redis://localhost:56379/0
# Required when APP_ENV=prod. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Used by the database tests: each test creates (and drops) its own database here.
TEST_DATABASE_URL=postgres://coin:coin@localhost:55432/postgres?sslmode=disable
